    "1": {
      "uid": 1,
      "key": [
        "洗脑",
        "催眠",
        "深度催眠",
        "给洗脑",
        "被催眠的",
        "恍惚",
        "洗脑",
        "催眠",
        "入口",
        "催眠"
      ],
      "keysecondary": [],
      "comment": "",
      "content": "催眠或恍惚是一种受试者接近睡眠的状态，他们的全部注意力都被说话的人的声音所吸引。在催眠过程中，潜意识接管了一切，这使得催眠成为接受任何建议的完美状态。目标越深入催眠，他们就越有可能接受建议。受试者越深入催眠，他们自己的动作就越少，说话也就越少。当从恍惚状态中醒来时，如果恍惚状态很轻，受试者可能会记得恍惚状态下发生的事情，但如果催眠状态很深，他们可能不会记得恍惚状态中发生的事情。",
      "constant": true,
      "selective": false,
      "selectiveLogic": 0,
      "order": 1,
