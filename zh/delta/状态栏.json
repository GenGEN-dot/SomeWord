{
  "name": "状态栏（统一格式）",
  "keys": ["状态栏"],
  "content": "<![CDATA[\n<details>\n<summary style=\"cursor:pointer; background:linear-gradient(90deg,#c2576d,#8e5cc0); padding:10px 15px; border-radius:10px 10px 0; color:#f0f0f0; font-weight:bold;\">\n  <span style=\"margin-right:8px;\">[情况]</span>{角色名}的状态\n</summary>\n<div style=\"background:#222; padding:10px 10px; overflow:hidden; max-width:350px; font-family:Arial,sans-serif;\">\n  <!-- 基础信息 -->\n  <div style=\"padding:15px; border-bottom:1px solid #333;\">\n    <div style=\"font-weight:bold; font-size:16px; color:#ffc0cb; margin-bottom:8px;\">{角色名}({英文名})</div>\n    <div style=\"display:grid; grid-template-columns:1fr 1fr; gap:8px 5px; font-size:12px; color:#d0d0e0;\">\n      <div>年龄：<span style=\"color:#ffffff\">{年龄}</span></div>\n      <div>身高：<span style=\"color:#ffffff\">{身高}</span></div>\n      <div style=\"grid-column:1/-1;\">性格类型：<span style=\"color:#ffb3ff; font-weight:bold;\">{性格}</span></div>\n    </div>\n  </div>\n  <!-- 核心状态 -->\n  <div style=\"padding:15px; border-bottom:1px solid #333;\">\n    <div style=\"font-size:12px; color:#81d4fa; margin-bottom:4px;\">💙 <strong>好感值：{好感度}/100</strong> ({好感度描述})</div>\n    <div style=\"width:100%; height:6px; background:#333; border-radius:3px; overflow:hidden;\">\n      <div style=\"width:{好感度}%; height:100%; background:#81d4fa;\"></div>\n    </div>\n    <div style=\"margin-top:8px; font-size:12px; color:#a5d6a7;\">👩 <strong>外貌</strong></div>\n    <div style=\"font-size:12px; color:#e0e0e0;\">{外貌简述}</div>\n  </div>\n  <!-- 私密档案（可折叠） -->\n  <div style=\"padding:15px;\">\n    <details>\n      <summary style=\"cursor:pointer; font-size:12px; color:#ffcc80;\">🌸 <strong>私密档案</strong></summary>\n      <div style=\"display:grid; grid-template-columns:1fr 1fr; gap:8px; font-size:12px; font-style:italic; padding-top:8px;\">\n        <div><div style=\"color:#ffcc80;\">🌷 <strong>小穴</strong></div><div style=\"color:#e0e0e0;\">{小穴描述}</div></div>\n        <div><div style=\"color:#ffcc80;\">👄 <strong>口腔</strong></div><div style=\"color:#e0e0e0;\">{口腔描述}</div></div>\n        <div><div style=\"color:#ffcc80;\">🍑 <strong>屁股</strong></div><div style=\"color:#e0e0e0;\">{屁股描述}</div></div>\n        <div><div style=\"color:#ffcc80;\">🍈 <strong>胸部</strong></div><div style=\"color:#e0e0e0;\">{胸部描述}</div></div>\n      </div>\n    </details>\n  </div>\n  <!-- 系统字段（隐藏展示，供XML调用） -->\n  <div style=\"display:none\" data-xml-fields>\n    角色={角色名}\n    好感度={好感度}\n    性欲值={性欲值}\n    性爱经验={性爱经验}\n    情绪={情绪}\n    服装={服装}\n    动作={动作}\n    状态={状态}\n    内心={内心}\n  </div>\n</div>\n</details>\n]]>",
  "insertion_order": 100,
  "priority": 250,
  "position": "after_char"
}