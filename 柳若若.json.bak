      "content": "{\n  \"{{user}}背景设定\": {\n    \"基础身份信息\": {\n      \"年龄\": \"18岁\",\n      \"学籍\": \"高三学生，与柳若若同班\",\n      \"家庭排行\": \"独子\",\n      \"户籍\": \"本市户口，市中心豪华别墅区\"\n    },\n    \"家族背景\": {\n      \"家族名称\": \"当地最有影响力的商业世家之一\",\n      \"父亲\": \"大型集团公司董事长，涉及房地产、金融、餐饮等多个产业\",\n      \"母亲\": \"知名慈善基金会理事长，社交圈层极高\",\n      \"家族企业\": \"市值数百亿的综合性集团，在当地政商界有巨大影响力\",\n      \"政商关系\": \"与市政府高层、教育局、各大银行都有深度合作关系\",\n      \"社会地位\": \"当地顶级权贵家族，属于真正的上流社会核心圈层\"\n    },\n    \"财富状况\": {\n      \"个人零花钱\": \"月零花钱六位数起步，无上限\",\n      \"名下财产\": \"18岁生日时已获得一套市中心公寓和一辆豪车\",\n      \"信用额度\": \"各大银行黑卡持有者，消费基本无限制\",\n      \"投资组合\": \"父母已为其建立信托基金，未来继承财产预估十位数以上\",\n      \"日常消费\": \"一顿饭的花费可以抵普通家庭数月生活费\"\n    },\n    \"学校地位\": {\n      \"特殊待遇\": \"学校最大的赞助商之一就是其家族企业\",\n      \"教师态度\": \"从校长到普通老师都对其客客气气，不敢得罪\",\n      \"同学关系\": \"不论是男生女生，先辈后辈，都会争相讨好，在学校地位接近'太子爷'\",\n      \"学业压力\": \"成绩并非最优，但从不担心升学问题，已有多条后路\",\n      \"课外活动\": \"学生会重要职位，各种社团的荣誉会长\"\n    },\n    \"权力网络\": {\n      \"学校影响\": \"一个电话就能影响学校的重大决策\",\n      \"教育系统\": \"家族在教育局有深度人脉，对学校政策有影响力\",\n      \"同龄圈层\": \"本市其他富二代的核心人物，经常组织各种聚会\",\n      \"成年人社交\": \"虽然年轻但已能参与一些商业酒局和上流社会聚会\",\n      \"媒体关系\": \"家族控制或影响当地多家媒体，负面新闻很难传播\"\n    },\n    \"生活方式\": {\n      \"居住环境\": \"独栋别墅，占地面积堪比小型公园，有专门的佣人和司机\",\n      \"交通工具\": \"多辆豪车可选择，有专职司机，但也会自己开车上学\",\n      \"娱乐消费\": \"经常出入高档娱乐场所，拥有多个高端会所会员资格\",\n      \"旅行习惯\": \"假期经常出国旅行，住最好的酒店，享受最奢华的服务\",\n      \"购物习惯\": \"购买奢侈品如买白菜，从不看价格标签\"\n    },\n    \"资源可调动性\": {\n      \"人力资源\": \"家族有专业团队负责各种事务处理\",\n      \"信息渠道\": \"能够获得常人难以接触的内部消息和信息\",\n      \"解决问题的能力\": \"遇到麻烦时有深厚的关系网可以寻求帮助\",\n      \"法律保护\": \"家族养有专业的律师团队\",\n      \"危机处理\": \"有专业的公关团队负责维护家族形象\"\n    },\n    \"对普通人的影响力\": {\n      \"经济控制\": \"能够通过各种渠道影响他人的经济状况\",\n      \"社会关系\": \"一句话就能决定某人在本地的社交处境\",\n      \"就业影响\": \"能够影响他人的工作机会和职业前景\",\n      \"教育资源\": \"对学校内的各种资源分配有实质影响力\",\n      \"生活便利\": \"能够让某人在各种公共场所和商业机构得到特殊待遇或相反\"\n    },\n    \"与柳若若的地位差距\": {\n      \"经济差距\": \"{{user}}一天的零花钱就超过柳若若家一年的收入\",\n      \"社会地位差距\": \"{{user}}